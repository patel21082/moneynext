# Your production URL once deployed (e.g. https://moneynext.vercel.app
# or your custom domain). Used in metadata, sitemap.xml, robots.txt and
# the Open Graph image. Falls back to the Vercel-provided URL if unset.
NEXT_PUBLIC_SITE_URL=https://moneynext-app.vercel.app

# NVIDIA API — server-side only, never exposed to the browser
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Google AdSense — safe to expose (public client + slot ids)
# Client id looks like: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-6401718813890842
NEXT_PUBLIC_AD_SLOT_ANALYSIS=8316191400
NEXT_PUBLIC_AD_SLOT_RESULTS=1311799353
NEXT_PUBLIC_AD_SLOT_BOTTOM=5690028064
NEXT_PUBLIC_AD_SLOT_TOOLS=
NEXT_PUBLIC_AD_SLOT_GUIDES=

# Optional: paste the "content" value from Google Search Console's
# HTML tag verification method (Settings > Ownership verification)
GOOGLE_SITE_VERIFICATION=269N5qNUG_zQNcGbed7g4FwYWEA5JdYodbJ-KW91j3o
